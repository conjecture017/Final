// This file runs natively on Vercel's Node.js edge network.
// It receives the fetch() POST request from your index.html form.

export default async function handler(req, res) {
    // 1. Only allow POST requests
    if (req.method !== 'POST') {
        return res.status(405).json({ message: 'Method Not Allowed' });
    }

    const { name, company, email, phone, details, website } = req.body;

    // 2. SPAM PROTECTION: The honeypot field. 
    // If the 'website' field has value, a bot filled it out.
    // We return a 200 OK so the bot thinks it succeeded and goes away.
    if (website) {
        return res.status(200).json({ message: 'Spam trapped successfully' });
    }

    // 3. VALIDATION: Basic server-side check ensuring inputs exist
    if (!name || !email || !company || !details || !phone) {
        return res.status(400).json({ message: 'Missing required fields' });
    }

    try {
        // --- IMPLEMENT YOUR MAILER HERE ---
        // Vercel does not send emails natively. You will need to use a provider
        // like Resend, SendGrid, or Nodemailer. 
        // 
        // Example using standard SendGrid:
        //
        // const sgMail = require('@sendgrid/mail');
        // sgMail.setApiKey(process.env.SENDGRID_API_KEY);
        //
        // const msg = {
        //   to: ['sales@psgxglobal.com', 'info@psgxglobal.com'], 
        //   from: 'noreply@psgxglobal.com', // Must be an authenticated domain
        //   subject: `New Quotation Request from ${company}`,
        //   text: `
        //     Name: ${name}
        //     Company: ${company}
        //     Email: ${email}
        //     Phone: ${phone}
        //     Details: 
        //     ${details}
        //   `,
        // };
        // await sgMail.send(msg);

        // 4. Return success back to the front-end
        return res.status(200).json({ message: 'Quote request submitted successfully' });

    } catch (error) {
        console.error("Error processing quote request:", error);
        return res.status(500).json({ message: 'Internal Server Error' });
    }
}